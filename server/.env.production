# Production Environment Variables for Render Deployment

# Node environment
NODE_ENV=production

# Server Port (Render will provide this automatically)
PORT=10000

# MongoDB Database URI (use MongoDB Atlas for production)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/recipeBuilder?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL (update with your Vercel domain)
CLIENT_URL=https://your-frontend-url.vercel.app

# Google OAuth (Optional - if you want to enable Google login)
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/google/callback
